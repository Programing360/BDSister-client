# ============================================================
# BDSisters.org — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BDSisters.org

# --- Better Auth ---
# Generate a 32+ character random secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=development_secret_key_change_me_in_production_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/bdsisters
DATABASE_URL=mongodb://127.0.0.1:27017/bdsisters

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_SERVER_URL=http://localhost:3000

# --- Cloudinary (Server-side only — do NOT prefix with NEXT_PUBLIC_) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public preset is safe to expose
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Email Notifications (Email Verification & Password Reset) ---
# Option A: Resend API (Recommended)
RESEND_API_KEY=
EMAIL_FROM=BDSisters <noreply@bdsisters.org>

# Option B: SMTP Server
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# --- Feature Flags (optional) ---
NEXT_PUBLIC_ENABLE_ANALYTICS=false
